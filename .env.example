# Neon: "pooled" para la app, "direct" (sin -pooler en el host) para migraciones de Prisma
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Better Auth (genera el secreto con: npx @better-auth/cli secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos de las profesoras/admins, separados por coma (entran con Google y quedan como admin)
ADMIN_EMAILS=profesora@gmail.com

# Cloudflare R2 (bucket privado; las claves son de un API Token con permiso de lectura/escritura)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
